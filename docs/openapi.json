    "/api/artworks": {
      "get": {
        "operationId": "ArtworksController_listArtworks",
        "parameters": [
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "description": "1–100, default 50.",
            "schema": {}
          },
          {
            "name": "artist",
            "required": false,
            "in": "query",
            "description": "Artist slug, e.g. amara-okafor.",
            "schema": {}
          },
          {
            "name": "medium",
            "required": false,
            "in": "query",
            "schema": {
              "enum": [
                "Painting",
                "Print",
                "Photography",
                "Sculpture",
                "Drawing",
                "Digital"
              ],
              "type": "string"
            }
          },
          {
            "name": "query",
            "required": false,
            "in": "query",
            "description": "Matches the title or the artist name, case-insensitively.",
            "schema": {}
          },
          {
            "name": "X-Request-Id",
            "in": "header",
            "required": false,
            "description": "Correlation ID echoed in the response; generated when absent or malformed.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "slug": {
                            "type": "string"
                          },
                          "title": {
                            "type": "string"
                          },
                          "year": {
                            "nullable": true,
                            "type": "integer",
                            "minimum": -9007199254740991,
                            "maximum": 9007199254740991
                          },
                          "medium": {
                            "type": "string",
                            "enum": [
                              "Painting",
                              "Print",
                              "Photography",
                              "Sculpture",
                              "Drawing",
                              "Digital"
                            ]
                          },
                          "dimensions": {
                            "type": "string"
                          },
                          "artist": {
                            "type": "object",
                            "properties": {
                              "slug": {
                                "type": "string"
                              },
                              "name": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "slug",
                              "name"
                            ],
                            "additionalProperties": false
                          },
                          "saleType": {
                            "type": "string",
                            "enum": [
                              "primary",
                              "resale"
                            ],
                            "description": "primary: the artist owns it; resale: a collector does."
                          }
                        },
                        "required": [
                          "slug",
                          "title",
                          "year",
                          "medium",
                          "dimensions",
                          "artist",
                          "saleType"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "items"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        },
        "summary": "Browse the catalog, newest first",
        "tags": [
          "artworks"
        ]
      }
    },
    "/api/artworks/{slug}": {
      "get": {
        "operationId": "ArtworksController_getArtwork",
        "parameters": [
          {
            "name": "slug",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Request-Id",
            "in": "header",
            "required": false,
            "description": "Correlation ID echoed in the response; generated when absent or malformed.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "slug": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "year": {
                      "nullable": true,
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    "medium": {
                      "type": "string",
                      "enum": [
                        "Painting",
                        "Print",
                        "Photography",
                        "Sculpture",
                        "Drawing",
                        "Digital"
                      ]
                    },
                    "dimensions": {
                      "type": "string"
                    },
                    "artist": {
                      "type": "object",
                      "properties": {
                        "slug": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        },
                        "bio": {
                          "type": "string"
                        },
                        "royaltyBps": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991,
                          "description": "Resale royalty in basis points (500 = 5%)."
                        }
                      },
                      "required": [
                        "slug",
                        "name",
                        "bio",
                        "royaltyBps"
                      ],
                      "additionalProperties": false
                    },
                    "saleType": {
                      "type": "string",
                      "enum": [
                        "primary",
                        "resale"
                      ],
                      "description": "primary: the artist owns it; resale: a collector does."
                    },
                    "description": {
                      "type": "string"
                    },
                    "ownerUserId": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    }
                  },
                  "required": [
                    "slug",
                    "title",
                    "year",
                    "medium",
                    "dimensions",
                    "artist",
                    "saleType",
                    "description",
                    "ownerUserId"
                  ],
                  "additionalProperties": false
                }
