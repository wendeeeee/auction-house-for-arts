              "type": "string"
            }
          },
          {
            "name": "artwork",
            "required": false,
            "in": "query",
            "description": "Artwork slug: that artwork’s auctions only.",
            "schema": {}
          },
          {
            "name": "medium",
            "required": false,
            "in": "query",
            "schema": {
              "enum": [
                "Painting",
                "Print",
                "Photography",
