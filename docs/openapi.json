          {
            "name": "X-Request-Id",
            "in": "header",
            "required": false,
            "description": "Correlation ID echoed in the response; generated when absent or malformed.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "All dependencies are up."
          },
          "503": {
            "description": "A dependency is down."
          }
        },
        "summary": "Liveness and database connectivity",
        "tags": [
          "health"
        ]
      }
    },
    "/api/users": {
