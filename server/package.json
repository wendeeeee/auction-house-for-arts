{
  "name": "@art-auction/server",
  "version": "0.1.0",
  "private": true,
  "description": "Art Auction House API and background workers (NestJS on Fastify).",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp -r src/database/migrations dist/database/",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev:api": "node --watch --env-file-if-exists=../.env -r ts-node/register/transpile-only src/main.ts",
    "dev:worker": "node --watch --env-file-if-exists=../.env -r ts-node/register/transpile-only src/worker.ts",
    "start:api": "node --env-file-if-exists=../.env dist/main.js",
    "start:worker": "node --env-file-if-exists=../.env dist/worker.js",
    "migrate": "node --env-file-if-exists=../.env -r ts-node/register/transpile-only src/database/run-migrations.ts",
    "seed": "node --env-file-if-exists=../.env -r ts-node/register/transpile-only src/database/seed/run-seed.ts",
    "seed:if-empty": "node --env-file-if-exists=../.env -r ts-node/register/transpile-only src/database/seed/run-seed.ts --if-empty",
    "db:reset": "node --env-file-if-exists=../.env -r ts-node/register/transpile-only src/database/reset-database.ts",
    "docs:openapi": "node --env-file-if-exists=../.env -r ts-node/register/transpile-only scripts/generate-openapi.ts",
    "test": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration --runInBand",
    "test:e2e": "jest --selectProjects e2e --runInBand"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-fastify": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/instrumentation-http": "^0.223.0",
    "@opentelemetry/instrumentation-pg": "^0.75.0",
    "@opentelemetry/instrumentation-undici": "^0.33.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "fastify": "^5.6.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  }
}
