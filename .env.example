# Copy to .env 
NODE_ENV=development

# API
API_PORT=4101

# PostgreSQL
DATABASE_URL=postgres://art_auction:art_auction@localhost:55442/art_auction
DATABASE_POOL_MAX=10
# Integration and e2e tests create, migrate, and truncate this database.
TEST_DATABASE_URL=postgres://art_auction:art_auction@localhost:55442/art_auction_test


OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4328
OTEL_SDK_DISABLED=false

# Auctions: a bid that changes the price or leader this close to the end extends the auction
# to (bid time + window). Default 120.
SOFT_CLOSE_WINDOW_SECONDS=120

# Ledger: the platform's commission on every sale, in basis points (1000 = 10%, at most 5000).
PLATFORM_FEE_BPS=1000

# Payments: Stripe Checkout in TEST MODE only;
# without it, checkout returns 503 and everything else works. The webhook secret comes from
#   stripe listen --events checkout.session.completed --forward-to localhost:4101/api/webhooks/stripe
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Where checkout sends the buyer back to.
WEB_BASE_URL=http://localhost:5201

# Redis: the Socket.IO adapter, so several API instances share real-time rooms.
REDIS_URL=redis://localhost:56380

# RabbitMQ: the worker publishes outbox events here and consumes them. 
RABBITMQ_URL=amqp://art_auction:art_auction@localhost:56727

# Object storage (MinIO locally) for artwork images. The browser uploads straight to S3_ENDPOINT
# with presigned URLs, so it must be reachable from the browser. The bucket is created at startup.
S3_ENDPOINT=http://localhost:59000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=art_auction
S3_SECRET_ACCESS_KEY=art_auction_secret
S3_BUCKET=artwork-images

# AI features. Without OPENAI_API_KEY the Concierge shows as offline and search uses keywords only.
# OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.2
# OPENAI_BASE_URL=http://localhost:11434/v1
# Concierge messages per user per hour.
ASSISTANT_TURNS_PER_HOUR=50
